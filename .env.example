# ============================================================
# MyPlatform .env 템플릿 — 실제 .env 는 git ignore 됨 (보안)
# 복사 후 사용:  cp .env.example .env  → 각 값을 실제 값으로 치환
# ============================================================

# -- Docker 이미지 태그 (prod/dev) --
DOCKER_TAG=prod
SPRING_PROFILES_ACTIVE=prod

# -- Database (MariaDB) --
DB_URL=jdbc:mysql://mariadb:3306/myplatform?permitMysqlScheme=true&autoReconnect=true
DB_USERNAME=myplatform
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=myplatform
MYSQL_USER=myplatform
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# -- JWT (32바이트 이상 랜덤 문자열) --
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM_STRING
JWT_EXPIRATION=86400000

# -- Redis --
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# -- Mail (SMTP) --
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD

# -- File Upload --
FILE_UPLOAD_DIR=/app/uploads

# -- 한국투자증권 API (실전매매용) --
KIS_APP_KEY=CHANGE_ME
KIS_APP_SECRET=CHANGE_ME
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_ACCOUNT_PREFIX=        # 계좌 앞 8자리
KIS_ACCOUNT_SUFFIX=01      # 계좌 뒤 2자리

# -- Gemini AI --
GEMINI_API_KEY=CHANGE_ME

# -- DART (전자공시) --
DART_API_KEY=CHANGE_ME

# -- 한국수출입은행 환율 API --
KOREAEXIM_API_KEY=CHANGE_ME

# -- Naver Search API --
NAVER_CLIENT_ID=CHANGE_ME
NAVER_CLIENT_SECRET=CHANGE_ME

# -- Reddit (선택) --
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=my-platform/1.0

# -- Telegram (3채널 분리) --
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN_SIGNAL=
TELEGRAM_CHAT_ID_SIGNAL=
TELEGRAM_BOT_TOKEN_RISK=
TELEGRAM_CHAT_ID_RISK=

# -- CORS (운영 도메인 콤마 구분) --
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

# -- WebAuthn (지문/Face ID) --
WEBAUTHN_RP_ID=your-domain.com
WEBAUTHN_ORIGIN=https://your-domain.com
WEBAUTHN_RP_NAME=MyPlatform

# -- 매매 안전장치 (실전매매 한도) --
TRADING_DAILY_BUY_LIMIT_KRW=5000000   # 일일 매수 한도 (원)
TRADING_ALERT_THRESHOLD_KRW=1000000   # 대형 거래 알림 임계 (원)

# -- 캐시 / 모니터 --
CACHE_REDIS_ENABLED=true
NEWS_GEMINI_DAILY_LIMIT=500           # 뉴스 요약 일간 Gemini 호출 상한

# -- 기타 선택 --
GOLD_API_KEY=
SILVER_API_KEY=
